	)
	(text "PF1-PF4: ERC power-source markers for nets fed by an\nexternal/passive element ERC cannot verify (solar panel,\nsupercap, regulated rail, load-switched rail) - not real parts."
		(at 230 15 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "3e34053a-77a9-4dc3-8df2-77b7c1d116d5")
	)
	(text "BQ25570 programming (see datasheet SLUSBH2G eqs 1-5):\nR1/R2 -> VBAT_OV ~5.23V (supercap overvoltage cutoff)\nR3/R4/R5 -> VBAT_OK falls 3.64V / rises 4.06V (auto load gate)\nR6/R7 -> VOUT ~3.31V regulated system rail\nVOC_SAMP tied to VSTOR = 80% MPPT for solar"
		(at 100 200 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "df51f496-a507-48e3-8e7e-27c345ae7a71")
	)
